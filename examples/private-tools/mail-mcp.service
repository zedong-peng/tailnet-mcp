[Unit]
Description=Mail MCP for agents (draft-only, loopback :18443)
After=network-online.target
Wants=network-online.target

[Service]
User=mcp
Group=mcp
Environment=HOME=/var/lib/mcp
EnvironmentFile=/etc/mcp/mail.env
ExecStart=/opt/node/bin/node /opt/mcp/mail/lib/node_modules/@n24q02m/email/bin/cli.mjs --http
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mcp
MemoryMax=400M

[Install]
WantedBy=multi-user.target
